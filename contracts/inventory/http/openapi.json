{
  "openapi": "3.1.1",
  "info": {
    "title": "B46 Private Inventory Adapter API",
    "version": "1.1.0",
    "description": "Private service-to-service API. It is not part of the mobile contract."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "inventoryLiveness",
        "responses": { "200": { "description": "Process is alive" } }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "inventoryReadiness",
        "responses": {
          "200": { "description": "Store schema and actor are ready" },
          "503": { "description": "Store is not ready" }
        }
      }
    },
    "/catalog/products": {
      "get": {
        "operationId": "listInventoryCatalogProducts",
        "security": [{ "serviceBearer": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } },
          { "name": "after_id", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "A POS-backed catalog page without stock quantities.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogPage" } } }
          },
          "400": { "$ref": "#/components/responses/TechnicalError" },
          "401": { "$ref": "#/components/responses/TechnicalError" },
          "503": { "$ref": "#/components/responses/TechnicalError" }
        }
      }
    },
    "/inventory/commit": {
      "post": {
        "operationId": "commitInventory",
        "security": [{ "serviceBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "../v1/inventory-commit-requested.schema.json" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable final business result",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "../v1/inventory-committed.schema.json" },
                    { "$ref": "../v1/inventory-items-unavailable.schema.json" }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/TechnicalError" },
          "401": { "$ref": "#/components/responses/TechnicalError" },
          "409": { "$ref": "#/components/responses/TechnicalError" },
          "413": { "$ref": "#/components/responses/TechnicalError" },
          "415": { "$ref": "#/components/responses/TechnicalError" },
          "500": { "$ref": "#/components/responses/TechnicalError" },
          "503": { "$ref": "#/components/responses/TechnicalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque service credential"
      }
    },
    "schemas": {
      "CatalogProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "name", "description", "price_centavos", "category_id", "category_name", "available", "source_updated_at"],
        "properties": {
          "product_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "price_centavos": { "type": "integer", "minimum": 0 },
          "category_id": { "type": "string", "format": "uuid" },
          "category_name": { "type": "string", "minLength": 1 },
          "available": { "type": "boolean" },
          "source_updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CatalogPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["products", "next_after_id"],
        "properties": {
          "products": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogProduct" } },
          "next_after_id": { "type": "string" }
        }
      },
      "TechnicalError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED",
              "CONTENT_TYPE_REQUIRED",
              "INVALID_REQUEST",
              "REQUEST_TOO_LARGE",
              "OPERATION_CONFLICT",
              "STORE_UNAVAILABLE",
              "INTERNAL_ERROR",
              "SERVICE_UNAVAILABLE"
            ]
          }
        }
      }
    },
    "responses": {
      "TechnicalError": {
        "description": "Safe technical error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/TechnicalError" }
          }
        }
      }
    }
  }
}
