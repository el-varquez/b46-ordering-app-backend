{
  "openapi": "3.1.1",
  "info": {
    "title": "B46 Ordering API",
    "version": "0.5.0",
    "description": "Phase 5 mobile contract with verified Customer email registration, identity, catalog, and the Customer/Cashier order lifecycle."
  },
  "servers": [{ "url": "http://localhost:8080" }],
  "paths": {
    "/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "The Ordering process is alive.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "PostgreSQL is reachable and current.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          },
          "503": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/auth/password/login": {
      "post": {
        "operationId": "passwordLogin",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordLoginRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/SessionResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "403": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/auth/password/registrations": {
      "post": {
        "operationId": "beginCustomerRegistration",
        "description": "Generic acknowledgement does not disclose whether the email already belongs to an account. Only a verified new address can become a Customer.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationStartRequest" } } } },
        "responses": {
          "202": { "$ref": "#/components/responses/RegistrationStartResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "429": { "$ref": "#/components/responses/ErrorResponse" },
          "503": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/auth/password/registrations/resend": {
      "post": {
        "operationId": "resendRegistrationCode",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationIDRequest" } } } },
        "responses": {
          "202": { "$ref": "#/components/responses/RegistrationStartResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "429": { "$ref": "#/components/responses/ErrorResponse" },
          "503": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/auth/password/registrations/verify": {
      "post": {
        "operationId": "verifyCustomerRegistration",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationVerifyRequest" } } } },
        "responses": {
          "200": { "$ref": "#/components/responses/SessionResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/auth/oauth/intents": {
      "post": {
        "operationId": "createOAuthLoginIntent",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthIntentRequest" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/OAuthIntentResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/auth/oauth/login": {
      "post": {
        "operationId": "oauthLogin",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthCompleteRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/SessionResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "409": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/SessionResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/StatusResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getCurrentUser",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/CurrentUserResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/me/oauth-link-intents": {
      "post": {
        "operationId": "createOAuthLinkIntent",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthIntentRequest" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/OAuthIntentResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/me/oauth-identities": {
      "post": {
        "operationId": "linkOAuthIdentity",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthCompleteRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/StatusResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "409": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/products": {
      "get": {
        "operationId": "listProducts",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/AfterID" },
          {
            "name": "snapshot_revision",
            "in": "query",
            "required": false,
            "description": "Revision returned by the first page; pass it unchanged on later pages.",
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ProductListResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "403": { "$ref": "#/components/responses/ErrorResponse" },
          "409": { "$ref": "#/components/responses/ErrorResponse" },
          "503": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/orders": {
      "post": {
        "operationId": "placeOrder",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlaceOrderRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/CustomerOrderResponse" },
          "202": { "$ref": "#/components/responses/CustomerOrderResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "403": { "$ref": "#/components/responses/ErrorResponse" },
          "409": { "$ref": "#/components/responses/ErrorResponse" }
        }
      },
      "get": {
        "operationId": "listCustomerOrders",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/AfterID" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CustomerOrderListResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "403": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/orders/{order_id}": {
      "get": {
        "operationId": "getCustomerOrder",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OrderID" }],
        "responses": {
          "200": { "$ref": "#/components/responses/CustomerOrderResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "403": { "$ref": "#/components/responses/ErrorResponse" },
          "404": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/staff/orders": {
      "get": {
        "operationId": "listCashierOrders",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/AfterID" },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/FulfillmentStatus" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CashierOrderListResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "403": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/staff/orders/{order_id}": {
      "get": {
        "operationId": "getCashierOrder",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OrderID" }],
        "responses": {
          "200": { "$ref": "#/components/responses/CashierOrderResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "403": { "$ref": "#/components/responses/ErrorResponse" },
          "404": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/staff/orders/{order_id}/read": {
      "post": {
        "operationId": "markCashierOrderRead",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OrderID" }],
        "responses": {
          "200": { "$ref": "#/components/responses/CashierOrderResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "403": { "$ref": "#/components/responses/ErrorResponse" },
          "404": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/v1/staff/orders/{order_id}/status": {
      "patch": {
        "operationId": "advanceCashierOrderStatus",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OrderID" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdvanceFulfillmentRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/CashierOrderResponse" },
          "400": { "$ref": "#/components/responses/ErrorResponse" },
          "401": { "$ref": "#/components/responses/ErrorResponse" },
          "403": { "$ref": "#/components/responses/ErrorResponse" },
          "404": { "$ref": "#/components/responses/ErrorResponse" },
          "409": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque" }
    },
    "parameters": {
      "OrderID": {
        "name": "order_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "AfterID": {
        "name": "after_id",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "responses": {
      "SessionResponse": {
        "description": "A new B46 mobile session token pair.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } } }
      },
      "RegistrationStartResponse": {
        "description": "A generic acknowledgement with an opaque registration attempt ID.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationStartEnvelope" } } }
      },
      "OAuthIntentResponse": {
        "description": "A one-time OAuth intent and provider nonce.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthIntentResponse" } } }
      },
      "CurrentUserResponse": {
        "description": "The canonical authenticated user.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CurrentUserResponse" } } }
      },
      "StatusResponse": {
        "description": "The operation completed.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StatusResponse" } } }
      },
      "ProductListResponse": {
        "description": "A stable keyset-paginated catalog snapshot without stock quantities.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductListEnvelope" } } }
      },
      "CustomerOrderResponse": {
        "description": "A Customer-safe order projection.",
        "headers": { "Location": { "schema": { "type": "string" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerOrderEnvelope" } } }
      },
      "CustomerOrderListResponse": {
        "description": "A page of the authenticated Customer's orders.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerOrderListEnvelope" } } }
      },
      "CashierOrderResponse": {
        "description": "A confirmed order for Cashier fulfillment.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CashierOrderEnvelope" } } }
      },
      "CashierOrderListResponse": {
        "description": "A page of confirmed fulfillment orders.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CashierOrderListEnvelope" } } }
      },
      "ErrorResponse": {
        "description": "A stable safe error.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "schemas": {
      "Role": { "type": "string", "enum": ["CUSTOMER", "CASHIER", "ADMIN"] },
      "Provider": { "type": "string", "enum": ["PASSWORD", "GOOGLE", "APPLE"] },
      "OAuthProvider": { "type": "string", "enum": ["GOOGLE"] },
      "AccountStatus": { "type": "string", "enum": ["ACTIVE", "DISABLED"] },
      "OrderStatus": { "type": "string", "enum": ["SUBMITTED", "CONFIRMED", "REJECTED"] },
      "FulfillmentStatus": { "type": "string", "enum": ["PREPARING", "DELIVERING", "DELIVERED"] },
      "CustomerOrderStatus": { "type": "string", "enum": ["PREPARING", "ON_THE_WAY", "DELIVERED", "REJECTED"] },
      "ResponseMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id"],
        "properties": { "request_id": { "type": "string", "minLength": 1, "maxLength": 128 } }
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "status"],
            "properties": {
              "service": { "type": "string", "const": "ordering" },
              "status": { "type": "string", "enum": ["ok", "ready"] }
            }
          },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "PasswordLoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "minLength": 8, "maxLength": 128, "writeOnly": true }
        }
      },
      "RegistrationStartRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "minLength": 8, "maxLength": 128, "writeOnly": true }
        }
      },
      "RegistrationIDRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registration_id"],
        "properties": { "registration_id": { "type": "string", "minLength": 32, "maxLength": 128 } }
      },
      "RegistrationVerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registration_id", "code"],
        "properties": {
          "registration_id": { "type": "string", "minLength": 32, "maxLength": 128 },
          "code": { "type": "string", "pattern": "^[0-9]{6}$", "writeOnly": true }
        }
      },
      "RegistrationStartData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registration_id", "expires_at"],
        "properties": {
          "registration_id": { "type": "string", "minLength": 32, "maxLength": 128 },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "RegistrationStartEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/RegistrationStartData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "OAuthIntentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider"],
        "properties": { "provider": { "$ref": "#/components/schemas/OAuthProvider" } }
      },
      "OAuthCompleteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent_id", "identity_token"],
        "properties": {
          "intent_id": { "type": "string", "format": "uuid" },
          "identity_token": { "type": "string", "minLength": 1, "writeOnly": true }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refresh_token"],
        "properties": { "refresh_token": { "type": "string", "minLength": 40, "writeOnly": true } }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id", "name", "email", "role", "status"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "role": { "$ref": "#/components/schemas/Role" },
          "status": { "$ref": "#/components/schemas/AccountStatus" }
        }
      },
      "SessionData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["access_token", "access_token_expires_at", "refresh_token", "refresh_token_expires_at", "user"],
        "properties": {
          "access_token": { "type": "string", "minLength": 40, "readOnly": true },
          "access_token_expires_at": { "type": "string", "format": "date-time" },
          "refresh_token": { "type": "string", "minLength": 40, "readOnly": true },
          "refresh_token_expires_at": { "type": "string", "format": "date-time" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "SessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/SessionData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "OAuthIntentData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent_id", "provider", "nonce", "expires_at"],
        "properties": {
          "intent_id": { "type": "string", "format": "uuid" },
          "provider": { "$ref": "#/components/schemas/OAuthProvider" },
          "nonce": { "type": "string", "minLength": 40, "readOnly": true },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "OAuthIntentResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/OAuthIntentData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "CurrentUserData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id", "name", "email", "role", "status", "connected_providers"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "role": { "$ref": "#/components/schemas/Role" },
          "status": { "$ref": "#/components/schemas/AccountStatus" },
          "connected_providers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Provider" },
            "uniqueItems": true
          }
        }
      },
      "CurrentUserResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/CurrentUserData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "StatusResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": { "status": { "type": "string", "enum": ["logged_out", "linked"] } }
          },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "name", "description", "price_centavos", "category_id", "category_name", "image_url", "available"],
        "properties": {
          "product_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 2000 },
          "price_centavos": { "type": "integer", "minimum": 0 },
          "category_id": { "type": "string", "format": "uuid" },
          "category_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "image_url": { "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }] },
          "available": { "type": "boolean" }
        }
      },
      "ProductPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["products", "snapshot_revision", "after_id", "has_more"],
        "properties": {
          "products": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
          "snapshot_revision": { "type": "integer", "minimum": 1 },
          "after_id": { "type": "string" },
          "has_more": { "type": "boolean" }
        }
      },
      "ProductListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/ProductPage" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "PlaceOrderLineRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "quantity", "expected_unit_price_centavos"],
        "properties": {
          "product_id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
          "expected_unit_price_centavos": { "type": "integer", "minimum": 0 }
        }
      },
      "PlaceOrderRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkout_id", "lines", "delivery_address"],
        "properties": {
          "checkout_id": { "type": "string", "format": "uuid" },
          "lines": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/components/schemas/PlaceOrderLineRequest" } },
          "delivery_address": { "type": "string", "minLength": 1, "maxLength": 500 },
          "delivery_notes": { "type": "string", "maxLength": 500, "default": "" }
        }
      },
      "AdvanceFulfillmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": { "status": { "$ref": "#/components/schemas/FulfillmentStatus" } }
      },
      "OrderLine": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order_line_id", "product_id", "product_name", "unit_price_centavos", "quantity", "line_total_centavos"],
        "properties": {
          "order_line_id": { "type": "string", "format": "uuid" },
          "product_id": { "type": "string" },
          "product_name": { "type": "string" },
          "unit_price_centavos": { "type": "integer", "minimum": 0 },
          "quantity": { "type": "integer", "minimum": 1 },
          "line_total_centavos": { "type": "integer", "minimum": 0 }
        }
      },
      "UnavailableItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "reason", "available"],
        "properties": {
          "product_id": { "type": "string" },
          "reason": { "type": "string", "const": "OUT_OF_STOCK" },
          "available": { "type": "boolean", "const": false }
        }
      },
      "OrderRejection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "unavailable_items"],
        "properties": {
          "reason": { "type": "string", "const": "ITEMS_UNAVAILABLE" },
          "unavailable_items": { "type": "array", "items": { "$ref": "#/components/schemas/UnavailableItem" } }
        }
      },
      "CustomerOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order_id", "checkout_id", "status", "subtotal_centavos", "delivery_fee_centavos", "total_centavos", "delivery_address", "delivery_notes", "lines", "created_at", "updated_at"],
        "properties": {
          "order_id": { "type": "string", "format": "uuid" },
          "checkout_id": { "type": "string", "format": "uuid" },
          "status": { "$ref": "#/components/schemas/CustomerOrderStatus" },
          "subtotal_centavos": { "type": "integer", "minimum": 0 },
          "delivery_fee_centavos": { "type": "integer", "minimum": 0 },
          "total_centavos": { "type": "integer", "minimum": 0 },
          "delivery_address": { "type": "string" },
          "delivery_notes": { "type": "string" },
          "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/OrderLine" } },
          "rejection": { "$ref": "#/components/schemas/OrderRejection" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CustomerOrderPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["orders", "next_after_id"],
        "properties": {
          "orders": { "type": "array", "items": { "$ref": "#/components/schemas/CustomerOrder" } },
          "next_after_id": { "type": "string" }
        }
      },
      "CustomerOrderEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": { "data": { "$ref": "#/components/schemas/CustomerOrder" }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } }
      },
      "CustomerOrderListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": { "data": { "$ref": "#/components/schemas/CustomerOrderPage" }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } }
      },
      "CashierCustomer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["customer_id", "name"],
        "properties": { "customer_id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } }
      },
      "CashierOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order_id", "customer", "status", "unread", "next_action", "subtotal_centavos", "delivery_fee_centavos", "total_centavos", "delivery_address", "delivery_notes", "lines", "created_at"],
        "properties": {
          "order_id": { "type": "string", "format": "uuid" },
          "customer": { "$ref": "#/components/schemas/CashierCustomer" },
          "status": { "$ref": "#/components/schemas/FulfillmentStatus" },
          "unread": { "type": "boolean" },
          "next_action": { "oneOf": [{ "$ref": "#/components/schemas/FulfillmentStatus" }, { "type": "null" }] },
          "subtotal_centavos": { "type": "integer", "minimum": 0 },
          "delivery_fee_centavos": { "type": "integer", "minimum": 0 },
          "total_centavos": { "type": "integer", "minimum": 0 },
          "delivery_address": { "type": "string" },
          "delivery_notes": { "type": "string" },
          "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/OrderLine" } },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "CashierOrderPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["orders", "next_after_id"],
        "properties": {
          "orders": { "type": "array", "items": { "$ref": "#/components/schemas/CashierOrder" } },
          "next_after_id": { "type": "string" }
        }
      },
      "CashierOrderEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": { "data": { "$ref": "#/components/schemas/CashierOrder" }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } }
      },
      "CashierOrderListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": { "data": { "$ref": "#/components/schemas/CashierOrderPage" }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST", "INVALID_CREDENTIALS", "INVALID_OAUTH_CREDENTIAL",
              "INVALID_REGISTRATION", "REGISTRATION_RATE_LIMITED", "EMAIL_UNAVAILABLE",
              "INVALID_OAUTH_INTENT", "IDENTITY_LINK_REQUIRED", "IDENTITY_ALREADY_LINKED",
              "ACCOUNT_DISABLED", "UNAUTHENTICATED", "FORBIDDEN", "NOT_FOUND",
              "CONFLICT", "CART_CHANGED", "ITEMS_UNAVAILABLE", "INVALID_TRANSITION",
              "CATALOG_SNAPSHOT_EXPIRED", "CATALOG_UNAVAILABLE",
              "SERVICE_UNAVAILABLE", "INTERNAL_ERROR"
            ]
          },
          "message": { "type": "string", "minLength": 1 }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "meta"],
        "properties": {
          "error": { "$ref": "#/components/schemas/Error" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      }
    }
  }
}
